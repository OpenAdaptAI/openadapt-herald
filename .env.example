# Herald configuration
# Copy to .env and fill in your values.

# LLM (or set ANTHROPIC_API_KEY in environment — herald falls back to it)
ANTHROPIC_API_KEY=sk-ant-...

# Repos to track (comma-separated org/repo or local paths)
HERALD_REPOS=owner/repo1,owner/repo2

# Discord webhook URL
HERALD_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Twitter/X (all four required for posting)
# HERALD_TWITTER_CONSUMER_KEY=
# HERALD_TWITTER_CONSUMER_SECRET=
# HERALD_TWITTER_ACCESS_TOKEN=
# HERALD_TWITTER_ACCESS_TOKEN_SECRET=

# LinkedIn
# HERALD_LINKEDIN_ACCESS_TOKEN=

# GitHub (optional, for fetching releases/PRs beyond git log)
# HERALD_GITHUB_TOKEN=ghp_...

# Defaults
HERALD_LOOKBACK_DAYS=7
HERALD_DEFAULT_MODEL=claude-sonnet-4-20250514
